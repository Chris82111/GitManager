<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.0.0</Version>
    <PackageTags>Git;Portable</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Core solution for using Git in a portable form.
    
Supports: Locally installed Git and system-specific plugins</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="THIRD_PARTY_LICENSES" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
  </ItemGroup>

</Project>
