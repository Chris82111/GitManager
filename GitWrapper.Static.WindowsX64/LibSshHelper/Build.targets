<Project>
  
  <Target Name="LibSshHelper_BuildEntryTarget"
    BeforeTargets="AssignTargetPaths;GenerateNuspec">
    
    <Message Text="LibSshHelper is included in project" Importance="high" />
    
    <Error
      Condition="$([System.String]::CompareOrdinal('$(DirectoryPrefix)', '$(CurrentDirectoryName)')) != 0"
      Text="The directory name '$(CurrentDirectoryName)' does not match DirectoryPrefix '$(DirectoryPrefix)'.&#xA;Please update DirectoryPrefix in all *.props and *.targets files in this directory." />
  
  </Target>
  
  
  <Target Name="LibSshHelper_PrepareTarget"
    BeforeTargets="AssignTargetPaths;GenerateNuspec"
    Condition="'$(EnableStaticGitUseWindows)' == 'true'">
    
    <Message
      Text="SSH helper: Preparing $(LibSshHelper_ExecutableRelative)"
      Importance="high" />

    <Exec
      Command="mkdir -p &quot;$(CurrentDirectoryName)&quot; &amp;&amp; $(DockerCmd) buildx build --output type=tar,dest=- &quot;$(CurrentDirectoryName)&quot; | tar -xf - -C &quot;$(CurrentDirectoryName)&quot;"
      WorkingDirectory="$(LibSshHelper_LibDirectory)"
      Condition="'$(LibSshHelper_Use)' == 'true' And !Exists('$(LibSshHelper_ExecutableRelative)')" />
    
    
    <Move
      SourceFiles="$(LibSshHelper_InPathsRelative)"
      DestinationFiles="$(LibSshHelper_ExecutableRelative)"
      Condition="'$(LibSshHelper_Use)' == 'true' And !Exists('$(LibSshHelper_ExecutableRelative)')" />
    
    <Error
      Condition="'$(LibSshHelper_Use)' == 'true' And !Exists('$(LibSshHelper_ExecutableRelative)')"
      Text="SSH helper executable was not generated: $(LibSshHelper_ExecutableRelative)" />
    
    <ItemGroup>
      <None Include="$(LibSshHelper_ExecutableRelative)"
        Condition="'$(LibSshHelper_Use)' == 'true'"
        Pack="true"
        PackagePath="$(LibSshHelper_RuntimeDirectory)"
        CopyToOutputDirectory="PreserveNewest" />
      
      <None Include="$(LibSshHelper_ExecutableRelative)"
        Condition="'$(LibSshHelper_Use)' != 'true'"
        Pack="true"
        PackagePath="$(LibSshHelper_RuntimeDirectory)" />
    
    </ItemGroup>
  
  </Target>
  
  
  <Target Name="LibSshHelper_CleanupTarget" BeforeTargets="Clean" >
    
    <!-- Do not remove, it is assumed that the exported file is error-free. -->
    <!-- RemoveDir Directories="$(LibSshHelper_RuntimeDirectory)" ContinueOnError="WarnAndContinue" /-->
  
  </Target>
  
  
  <Target Name="LibSshHelper_GeneratePathTarget"
    BeforeTargets="CoreCompile;Pack"
    Inputs="$(LibSshHelper_LibRelative)"
    Outputs="$(LibSshHelper_PathsRelative)" >
    
    <PropertyGroup>
      <LibSshHelper_ExecutableRelativeForwardSlash>$([System.String]::Copy('$(LibSshHelper_ExecutableRelative)').Replace('\', '/'))</LibSshHelper_ExecutableRelativeForwardSlash>
    </PropertyGroup>
    
    <WriteLinesToFile
      File="$(LibSshHelper_PathsRelative)"
      Overwrite="true"
      Lines='
// This code was generated by a tool in the file "$(MSBuildThisFile)".
// 
// Changes to this file may cause incorrect behavior and will be lost if
// the code is regenerated.
namespace Chris82111.$(SolutionName).$(MSBuildProjectName.Replace(" ", "_")).$(CurrentDirectoryName)
{
/// &lt;summary&gt;
/// Paths and names to the archive
/// &lt;/summary&gt;
public static class $(LibSshHelper_PathsClass)
{        
    /// &lt;summary&gt;
    /// Relative path to the archive
    /// &lt;/summary&gt;
    public const string FileRelative = @"$(LibSshHelper_ExecutableRelativeForwardSlash)"%3B
}
}
' />
    
    <ItemGroup>
      <Compile Remove="$(LibSshHelper_PathsRelative)" />
      <Compile Include="$(LibSshHelper_PathsRelative)" />
    </ItemGroup>
  
  </Target>

</Project>