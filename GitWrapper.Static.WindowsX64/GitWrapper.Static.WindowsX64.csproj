<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RuntimeIdentifier>windows-x64</RuntimeIdentifier>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>1.0.0</Version>
    <PackageTags>Git;Portable;Static;Windows</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <Description>Plugin to extend the Core solution for using Git in a portable form.
    
Supports: Windows X64</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitWrapper.Core\GitWrapper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="THIRD_PARTY_LICENSES" Pack="true" PackagePath="/" />
  </ItemGroup>
    
</Project>
