<Project>
  
  <ItemGroup Condition="'true' == '$(EnableStaticGitUseWindows)' And 'true' == '$(UseGitWindows)'">
    <None
      Include="$(GitWindowsArchiveFileRelative)"
      Pack="true"
      PackagePath="$(GitWindowsRuntimeDirectory)" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
  <ItemGroup Condition="'true' == '$(EnableStaticGitUseWindows)' And 'false' == '$(UseGitWindows)'">
    <None
      Include="$(GitWindowsArchiveFileRelative)"
      Pack="true"
      PackagePath="$(GitWindowsRuntimeDirectory)" >
    </None>
  </ItemGroup>
  
  <Target Name="GitWindowsPropertyGroup"
    BeforeTargets="BeforeBuild;Pack" >
    
    <PropertyGroup>
    
    </PropertyGroup>
  
  </Target>
  
  <Target Name="GitWindowsArchiveDownload"
    AfterTargets="GitWindowsPropertyGroup"
    Outputs="$(GitWindowsArchiveFileRelative)"
    Condition="!Exists('$(GitWindowsArchiveFileRelative)') And 'true' == '$(EnableStaticGitUseWindows)'" >
    
    <Message Text="Git Windows: Download ZIP" Importance="High" />
    
    <DownloadFile
      Condition="!Exists('$(GitWindowsArchiveFileUncheckedRelative)')"
      SkipUnchangedFiles="true"
      SourceUrl="$(GitWindowsUrl)"
      DestinationFolder="$(GitWindowsRuntimeDirectory)"
      DestinationFileName="$(GitWindowsArchiveFileUnchecked)" >
    </DownloadFile>
    
    <GetFileHash
      Files="$(GitWindowsArchiveFileUncheckedRelative)" 
      Algorithm="SHA256" >
      <Output TaskParameter="Hash" ItemName="GitWindowsActualHashInfo" />
    </GetFileHash>
    
    <PropertyGroup>
      <GitWindowsActualHash>@(GitWindowsActualHashInfo)</GitWindowsActualHash>
    </PropertyGroup>

    <Error
      Condition="'$(GitWindowsActualHash)' != '$(GitWindowsExpectedHash)'"
      Text="Git Windows: Error: ZIP hash does not match expected SHA256 hash!" />
    
    <Move SourceFiles="$(GitWindowsArchiveFileUncheckedRelative)" DestinationFiles="$(GitWindowsArchiveFileRelative)" />
  
  </Target>
  
  <Target Name="GitWindowsCleanup" BeforeTargets="Clean" >
    
    <!-- Do not remove, it is assumed that the exported file is error-free. -->
    <!-- RemoveDir Directories="$(GitWindowsRuntimeDirectory)" ContinueOnError="WarnAndContinue" /-->
  
  </Target>
  
  <Target Name="GitWindowsGeneratePath"
    BeforeTargets="BeforeCompile;Pack"
    Inputs="$(GitWindowsLibRelative)"
    Outputs="$(ArchivePathsFileRelative)" >
    
    <PropertyGroup>
      <GitWindowsOutputArchiveFileRelativeForwardSlash>$([System.String]::Copy('$(GitWindowsOutputArchiveFileRelative)').Replace('\', '/'))</GitWindowsOutputArchiveFileRelativeForwardSlash>
      <GitWindowsOutputExecutableRelativeForwardSlash>$([System.String]::Copy('$(GitWindowsOutputExecutableRelative)').Replace('\', '/'))</GitWindowsOutputExecutableRelativeForwardSlash>
    </PropertyGroup>
    
    <WriteLinesToFile
      File="$(ArchivePathsFileRelative)"
      Overwrite="true"
      Lines='
// This code was generated by a tool in the file "$(MSBuildThisFile)".
// 
// Changes to this file may cause incorrect behavior and will be lost if
// the code is regenerated.
namespace Chris82111.$(SolutionName).$(MSBuildProjectName.Replace(" ", "_")).Lib
{
    /// &lt;summary&gt;
    /// Paths and names to the archive
    /// &lt;/summary&gt;
    public static class ArchivePaths
    {
        /// &lt;summary&gt;
        /// Download URL
        /// &lt;/summary&gt;
        public const string Url = @"$(GitWindowsUrl)"%3B
        
        /// &lt;summary&gt;
        /// SHA256 hash value
        /// &lt;/summary&gt;
        public const string ExpectedHash = "$(GitWindowsExpectedHash)"%3B
        
        /// &lt;summary&gt;
        /// Relative path to the archive
        /// &lt;/summary&gt;
        public const string ArchiveFileRelative = @"$(GitWindowsOutputArchiveFileRelativeForwardSlash)"%3B
        
        /// &lt;summary&gt;
        /// Relative path in the archive
        /// &lt;/summary&gt;
        public const string ExecutableRelative = @"$(GitWindowsOutputExecutableRelativeForwardSlash)"%3B
    }
}
' />
  
  </Target>

</Project>