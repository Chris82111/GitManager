<Project>
  
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <RootNamespace>Chris82111.$(SolutionName).$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <AssemblyName>Chris82111.$(SolutionName).$(MSBuildProjectName.Replace(" ", "_"))</AssemblyName>
    <PackageId>Chris82111.$(SolutionName).$(MSBuildProjectName.Replace(" ", "_"))</PackageId>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Authors>Chris82111</Authors>
    <Company>GitManager</Company>
    <RepositoryUrl>https://github.com/Chris82111/GitManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Product>GitManager</Product>

    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <Copyright>Copyright (c) Chris82111 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>